# Salin berkas ini menjadi .env dan masukkan API Key Gemini Anda.
# JANGAN PERNAH meng-commit berkas .env asli yang berisi secret ke Git!

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
APP_PORT=8501

# Pengaturan Batas Pemakaian AI (Quota & Rate Limit)
MAX_AI_CALLS_PER_SESSION=15
MIN_AI_COOLDOWN_SECONDS=2.0
MAX_QUERY_CHARS=500
